typeset -g _solder_dir=$SOLDER_SHELL_DIR
typeset -g _solder_zdotdir=$SOLDER_SHELL_ZDOTDIR
typeset -g _solder_zdotdir_set=$SOLDER_SHELL_ZDOTDIR_SET
if [[ $_solder_zdotdir_set == 1 ]]; then
    ZDOTDIR=$_solder_zdotdir
else
    unset ZDOTDIR
fi
